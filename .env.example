# Enterprise RAG Intel Continuum -- Environment Configuration
#
# Copy this file to .env and customize for your environment.

# Ollama endpoints for laptop development
EMBEDDING_ENDPOINT=http://localhost:11434
GENERATION_ENDPOINT=http://localhost:11434
GENERATION_API_TYPE=ollama
GENERATION_API_KEY=

# Model names (must be pulled in Ollama)
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5:1.5b

# Demo mode: true = use deterministic demo responses when models unavailable
DEMO_MODE=true

# For RHDP MaaS, leave EMBEDDING_ENDPOINT empty to use deterministic local
# demo embeddings, and configure generation with the OpenAI-compatible API:
# GENERATION_ENDPOINT=https://your-maas-endpoint
# GENERATION_API_TYPE=openai
# GENERATION_API_KEY=your-virtual-key
# GENERATION_MODEL=qwen3-14b

# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Embedding dimension (nomic-embed-text uses 768)
EMBEDDING_DIM=768
